<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>javaweb-user 用户管理系统</display-name>

    <!-- 访问项目根路径时默认打开的页面 -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <!--
        POST 中文编码声明（Servlet 4.0 / Tomcat 9 及以上支持）。
        没有这两行，表单提交的中文（比如真实姓名）到 Servlet 里就是乱码。
        每个 Servlet 里还会再调一次 request.setCharacterEncoding("UTF-8") 双保险。
    -->
    <request-character-encoding>UTF-8</request-character-encoding>
    <response-character-encoding>UTF-8</response-character-encoding>

    <!--
        三个 Servlet 一律用 @WebServlet 注解注册。
        注意：注解和这里的 <servlet-mapping> 只能用一种，
        两种同时写会导致同一个 Servlet 被注册两次（访问会 404 或行为诡异）。
    -->
</web-app>
